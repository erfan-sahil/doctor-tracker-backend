# Copy to docker.env (gitignored). Required for `docker compose up`.
# Run: npm run docker:init

NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://mongodb:27017/doctor-tracker?retryWrites=false
CORS_ORIGIN=http://localhost:3000
ACCESS_TOKEN_SECRET=replace-with-openssl-rand-hex-32
REFRESH_TOKEN_SECRET=replace-with-different-openssl-rand-hex-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password-min-8-chars
# Set true only for first deploy / local bootstrap, then false.
SEED_ADMIN=false