# Copy to .env (gitignored). Used by `npm run dev`, seeds, and `docker compose up`.
# Run: npm run env:init

NODE_ENV=development
PORT=5000
# Local: mongodb://127.0.0.1:27017/doctor-tracker?retryWrites=false
# Docker Compose (bundled Mongo): mongodb://mongodb:27017/doctor-tracker?retryWrites=false
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker?retryWrites=false
CORS_ORIGIN=http://localhost:3000
ACCESS_TOKEN_SECRET=replace-with-a-random-string-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-a-different-random-string-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
# Docker entrypoint only: true on first boot to create admin, then false.
SEED_ADMIN=false